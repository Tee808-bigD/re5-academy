# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Authentication ─────────────────────────────────────────────────
JWT_SECRET=               # Secret key for signing JWT session tokens (generate a strong random string)

# ── Admin Role ─────────────────────────────────────────────────────
ADMIN_EMAIL=              # Email address that gets "admin" role on first login (optional)
